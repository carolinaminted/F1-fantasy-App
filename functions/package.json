{
  "name": "functions",
  "description": "Cloud Functions for F1 Fantasy League",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:staging": "node scripts/seed-staging.js --project formula-fantasy-staging"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^6.0.0",
    "nodemailer": "^6.9.13"
  },
  "private": true
}
