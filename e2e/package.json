{
  "name": "lol-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "unit": "node --experimental-transform-types --no-warnings --test 'lib/**/*.test.ts'",
    "journeys": "playwright test --project=desktop --project=mobile",
    "harness": "playwright test --project=harness",
    "spikes": "E2E_SPIKES=1 playwright test --project=spikes",
    "provision": "node --experimental-transform-types --no-warnings scripts/provision.ts",
    "teardown": "node --experimental-transform-types --no-warnings scripts/teardown.ts",
    "check-live": "node --experimental-transform-types --no-warnings scripts/check-live.ts",
    "compare": "node --experimental-transform-types --no-warnings scripts/compare.ts",
    "capture": "node --experimental-transform-types --no-warnings scripts/capture.ts",
    "check-clean": "node --experimental-transform-types --no-warnings scripts/check-clean.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@playwright/test": "~1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/pngjs": "^6.0.5",
    "diff": "^9.0.0",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "picomatch": "^4.0.7",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.0"
  }
}
